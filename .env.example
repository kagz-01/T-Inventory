# ---- Supabase Postgres ----
# In Supabase: Project Settings -> Database -> Connection string
# DATABASE_URL = "Connection pooling" string (port 6543, includes ?pgbouncer=true)
# DIRECT_URL   = "Direct connection" string (port 5432) - needed for prisma migrate
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# ---- NextAuth ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-generated-secret"
NEXTAUTH_URL="http://localhost:3000"

# ---- Google OAuth ----
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ---- Supabase Storage (for material/task photos) ----
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- Admin bootstrap ----
# First user to sign in with this email is auto-promoted to ADMIN role
ADMIN_BOOTSTRAP_EMAIL="you@yourcompany.com"
